// GS WorkHub — Prisma schema
// This file is both the runtime data model and the "PostgreSQL Schema" deliverable
// (see docs/02-database-erd.md for the rendered ERD). Enum values are mirrored
// exactly in packages/shared/src/enums.ts — keep both in sync when changing either.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organization / Department / Team  (Org -> Department -> Team -> Project -> Milestone -> Task)
// ---------------------------------------------------------------------------

model Organization {
  id          String       @id @default(uuid())
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
}

model Department {
  id             String    @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  code           String    @unique
  description    String?
  managerId      String?
  manager        User?     @relation("DepartmentManager", fields: [managerId], references: [id])
  isArchived     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  teams        Team[]
  employees    User[]     @relation("EmployeeDepartment")
  projects     Project[]
  kpiSnapshots KpiSnapshot[]

  @@index([organizationId])
}

model Team {
  id                   String     @id @default(uuid())
  departmentId         String
  department           Department @relation(fields: [departmentId], references: [id])
  name                 String
  code                 String     @unique
  teamLeadId           String?
  teamLead             User?      @relation("TeamLead", fields: [teamLeadId], references: [id])
  capacityHoursPerWeek Float      @default(40)
  // Default delivery methodology for this team.
  methodology          ProjectMethodology @default(AGILE)
  isArchived           Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  members      TeamMember[]
  projects     Project[]
  kpiSnapshots KpiSnapshot[]

  @@index([departmentId])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  joinedAt  DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Identity / RBAC
// ---------------------------------------------------------------------------

enum SystemRole {
  SUPER_ADMIN
  DEPARTMENT_MANAGER
  TEAM_LEAD
  EMPLOYEE
  CLIENT
}

enum EmployeeAvailability {
  AVAILABLE
  PARTIALLY_AVAILABLE
  UNAVAILABLE
  ON_LEAVE
}

model User {
  id                   String               @id @default(uuid())
  fullName             String
  email                String               @unique
  passwordHash         String
  role                 SystemRole           @default(EMPLOYEE)
  designation          String?
  skills               String[]             @default([])
  availability         EmployeeAvailability @default(AVAILABLE)
  capacityHoursPerWeek Float                @default(40)
  avatarUrl            String?
  departmentId         String?
  department           Department?          @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  managedDepartments   Department[]  @relation("DepartmentManager")
  ledTeams             Team[]        @relation("TeamLead")
  teamMemberships      TeamMember[]
  refreshTokens        RefreshToken[]
  ownedProjects        Project[]     @relation("ProjectOwner")
  assignedTasks        TaskAssignee[]
  watchedTasks         TaskWatcher[]
  comments             Comment[]
  timesheetEntries     TimesheetEntry[]
  approvalRequests     ApprovalRequest[] @relation("ApprovalRequester")
  approvalsDecided     ApprovalRequest[] @relation("ApprovalApprover")
  notifications        Notification[]
  auditLogs             AuditLog[]
  uploadedAttachments   Attachment[]

  @@index([departmentId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Projects / Milestones
// ---------------------------------------------------------------------------

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  REVIEW
  COMPLETED
  CANCELLED
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ProjectMethodology {
  AGILE
  KANBAN
  WATERFALL
}

model ProjectTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  defaultMilestones Json  @default("[]")
  createdAt   DateTime @default(now())
}

model Project {
  id           String        @id @default(uuid())
  departmentId String
  department   Department    @relation(fields: [departmentId], references: [id])
  teamId       String?
  team         Team?         @relation(fields: [teamId], references: [id])
  name         String
  description  String?
  status       ProjectStatus @default(PLANNING)
  priority     Priority      @default(MEDIUM)
  startDate    DateTime?
  dueDate      DateTime?
  healthScore  Int           @default(100)
  ownerId      String
  owner        User          @relation("ProjectOwner", fields: [ownerId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  milestones Milestone[]
  tasks      Task[]
  files      Attachment[]
  approvals  ApprovalRequest[]

  @@index([departmentId])
  @@index([teamId])
}

model Milestone {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  name        String
  dueDate     DateTime?
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())

  tasks Task[]

  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  TESTING
  COMPLETED
}

model Task {
  id             String     @id @default(uuid())
  projectId      String
  project        Project    @relation(fields: [projectId], references: [id])
  milestoneId    String?
  milestone      Milestone? @relation(fields: [milestoneId], references: [id])
  parentTaskId   String?
  parentTask     Task?      @relation("SubTasks", fields: [parentTaskId], references: [id])
  subtasks       Task[]     @relation("SubTasks")
  title          String
  description    String?
  status         TaskStatus @default(BACKLOG)
  priority       Priority   @default(MEDIUM)
  dueDate        DateTime?
  estimatedHours Float?
  isRecurring    Boolean    @default(false)
  recurrenceRule String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  assignees          TaskAssignee[]
  watchers           TaskWatcher[]
  comments           Comment[]
  attachments        Attachment[]
  activityEntries    ActivityLogEntry[]
  timesheetEntries   TimesheetEntry[]
  dependenciesFrom   TaskDependency[] @relation("DependentTask")
  dependenciesTo     TaskDependency[] @relation("PrerequisiteTask")

  @@index([projectId])
  @@index([milestoneId])
  @@index([parentTaskId])
}

model TaskAssignee {
  id     String @id @default(uuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
}

model TaskWatcher {
  id     String @id @default(uuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
}

model TaskDependency {
  id                String @id @default(uuid())
  dependentTaskId    String
  dependentTask      Task   @relation("DependentTask", fields: [dependentTaskId], references: [id])
  prerequisiteTaskId String
  prerequisiteTask   Task   @relation("PrerequisiteTask", fields: [prerequisiteTaskId], references: [id])

  @@unique([dependentTaskId, prerequisiteTaskId])
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([taskId])
}

model ActivityLogEntry {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  actorId   String
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  @@index([taskId])
}

model Attachment {
  id           String   @id @default(uuid())
  fileName     String
  mimeType     String
  sizeBytes    Int
  blobPath     String
  version      Int      @default(1)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id])
  taskId       String?
  task         Task?    @relation(fields: [taskId], references: [id])
  createdAt    DateTime @default(now())

  @@index([projectId])
  @@index([taskId])
}

// ---------------------------------------------------------------------------
// Timesheets
// ---------------------------------------------------------------------------

enum TimesheetStatus {
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model TimesheetEntry {
  id        String           @id @default(uuid())
  employeeId String
  employee   User            @relation(fields: [employeeId], references: [id])
  taskId     String?
  task       Task?           @relation(fields: [taskId], references: [id])
  projectId  String?
  date       DateTime
  hours      Float
  notes      String?
  status     TimesheetStatus @default(SUBMITTED)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  approvalRequest ApprovalRequest?

  @@index([employeeId, date])
}

// ---------------------------------------------------------------------------
// Approvals (generic — covers timesheet / leave / task / content / design / project)
// ---------------------------------------------------------------------------

enum ApprovalType {
  TIMESHEET
  LEAVE
  TASK
  CONTENT
  DESIGN
  PROJECT
}

enum ApprovalStatus {
  DRAFT
  SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

model ApprovalRequest {
  id              String         @id @default(uuid())
  type            ApprovalType
  status          ApprovalStatus @default(DRAFT)
  requesterId     String
  requester       User           @relation("ApprovalRequester", fields: [requesterId], references: [id])
  approverId      String?
  approver        User?          @relation("ApprovalApprover", fields: [approverId], references: [id])
  entityLabel     String
  timesheetEntryId String?       @unique
  timesheetEntry   TimesheetEntry? @relation(fields: [timesheetEntryId], references: [id])
  projectId        String?
  project          Project?      @relation(fields: [projectId], references: [id])
  comment          String?
  submittedAt      DateTime?
  decidedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([requesterId])
  @@index([approverId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationType {
  TASK_UPDATE
  PROJECT_UPDATE
  APPROVAL_REQUEST
  DUE_DATE_REMINDER
  TEAM_ANNOUNCEMENT
  MENTION
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

// ---------------------------------------------------------------------------
// KPI / Audit
// ---------------------------------------------------------------------------

model KpiSnapshot {
  id           String      @id @default(uuid())
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  teamId       String?
  team         Team?       @relation(fields: [teamId], references: [id])
  snapshotDate DateTime
  taskCompletionRate  Float
  productivityScore   Float
  utilizationPct      Float
  slaCompliancePct    Float
  createdAt    DateTime    @default(now())

  @@index([departmentId, snapshotDate])
  @@index([teamId, snapshotDate])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}
